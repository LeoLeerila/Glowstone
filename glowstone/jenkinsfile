pipeline {
    agent any

    tools {
        maven 'maven'
    }

    environment {
        SONARQUBE_SERVER = 'SonarQubeServer'
        SONAR_TOKEN = credentials('sonarqube')
        //PATH = "C:\\Program Files\\Docker\\Docker\\resources\\bin;${env.PATH}"
        DOCKERHUB_CREDENTIALS_ID = 'Docker_pat'
        DOCKERHUB_REPO = 'leoleerila/glowstone'
        DOCKER_IMAGE_TAG = 'v2'
    }

    stages {
        stage ('check'){
            steps{
                git branch: 'main', url: 'https://github.com/LeoLeerila/Glowstone.git'
            }
        }
        stage ('build'){
            steps{
                sh 'mvn clean install -f "./glowstone/"'
            }
        }

        stage('test') {
            steps{
                sh 'mvn test -f "./glowstone/"'
            }
        }
        stage('jacoco'){
            steps{
                jacoco()
            }
        }
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${env.SONARQUBE_SERVER}") {
                    sh """
                        sonar-scanner ^
                        -Dsonar.projectKey=glowstoneKey ^
                        -Dsonar.sources=src ^
                        -Dsonar.projectName=Glowstone ^
                        -Dsonar.host.url=http://localhost:9000 ^
                        -Dsonar.login=${env.SONAR_TOKEN} ^
                        -Dsonar.java.binaries=target/classes
                    """
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${DOCKERHUB_REPO}:${DOCKER_IMAGE_TAG}", './glowstone/')
                }
            }
        }

        stage('Push Docker Image to Docker Hub') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDENTIALS_ID) {
                        docker.image("${DOCKERHUB_REPO}:${DOCKER_IMAGE_TAG}").push()
                    }
                }
            }
        }
    }
}